# NextAuth.js (สำหรับ Google Login)
# สร้าง secret: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL ของเว็บ (พัฒนาใช้ http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000

# Google OAuth: สร้างที่ Google Cloud Console > APIs & Services > Credentials
# ใส่ Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
